# shellcheck shell=bash disable=SC2034 # settings, read by lab.sh
# Settings of veho's DevStack lab (.specs/veho-openstack.md §6).
#
# Every setting has its default here. To change one for a single machine, set
# it in lab.local.env next to this file (git-ignored); to change it for one
# command, set it in the environment. The environment wins over lab.local.env,
# which wins over this file.

# --- Versions -----------------------------------------------------------------

# Ubuntu release of the VM.
LAB_UBUNTU_RELEASE="24.04"
# DevStack branch; empty: the most recent stable/* branch, resolved at "up".
LAB_DEVSTACK_BRANCH=""
# Cloud image URL; empty: derived from the release. Set it to use a mirror.
LAB_UBUNTU_IMAGE_URL=""
# SHA-256 of the image; empty: read from the SHA256SUMS published next to it.
LAB_UBUNTU_IMAGE_SHA256=""
# A copy of the same cloud image already on this machine (for example another
# lab's download cache), used instead of downloading it when its SHA-256
# matches. Nothing else is shared with any other lab.
LAB_IMPORT_IMAGE=""

# --- Network ------------------------------------------------------------------

# libvirt NAT network of the lab, and its IPv4 subnet (a /24). The other labs
# on the maintainer's host use 10.250.0.0/24 (openstack-spiffe),
# 10.251.0.0/24, 10.252.0.0/24 (ligo) and 10.254.0.0/24 (veho's test/lab).
LAB_NETWORK="veho-devstack"
LAB_SUBNET="10.253.0.0/24"
# Host part of the VM's address in LAB_SUBNET; the lab host is .1.
LAB_DEVSTACK_HOST="10"

# --- Size ---------------------------------------------------------------------

# vCPUs, RAM (GiB) and disk (GiB) of the VM: Keystone, Glance and Swift only.
LAB_DEVSTACK_VCPUS="4"
LAB_DEVSTACK_RAM_GIB="12"
LAB_DEVSTACK_DISK_GIB="60"

# --- Locations ----------------------------------------------------------------

# Lab state: SSH key, passwords, DevStack's CA, env.json. Relative paths are
# relative to this directory. Removed by "down".
LAB_STATE_DIR=".state"
# Downloaded images, kept across "down".
LAB_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/veho-devstack-lab"
# libvirt storage pool of the VM's disks, and its directory.
LAB_POOL="veho-devstack"
LAB_POOL_DIR="/var/lib/libvirt/images/veho-devstack"

# --- Behaviour ----------------------------------------------------------------

# Non-empty: answer yes to the confirmations (down, snapshot).
LAB_ASSUME_YES=""
