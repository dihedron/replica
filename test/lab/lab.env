# shellcheck shell=bash disable=SC2034 # settings, read by lab.sh
# Settings of the veho lab (see .specs/veho-lab.md).
#
# Every setting has its default here. To change one for a single machine, set
# it in lab.local.env next to this file (git-ignored); to change it for one
# command, set it in the environment. The environment wins over lab.local.env,
# which wins over this file.

# --- Versions -----------------------------------------------------------------

# Image of the lab VM and of the inner containers, as REMOTE:ALIAS.
LAB_IMAGE="ubuntu:24.04"
# etcd, upstream (backlog 28), verified against the release's SHA256SUMS.
LAB_ETCD_VERSION="3.6.16"
# PostgreSQL major version and Patroni version (apt version prefixes), from
# the PGDG repository: Ubuntu's Patroni 3.2 has no quorum synchronous mode.
LAB_PG_MAJOR="16"
LAB_PATRONI_VERSION="4.1.5"
# The PGDG archive signing key (ACCC4CF8), checked before it is trusted.
LAB_PGDG_KEY_FINGERPRINT="B97B0AFCAA1A47F044F244A07FCC7D46ACCC4CF8"
# Garage (x86_64-unknown-linux-musl). Garage publishes no checksums: this
# SHA-256 was recorded on 2026-11-21 from the release's download; set both
# when changing the version.
LAB_GARAGE_VERSION="2.5.0"
LAB_GARAGE_SHA256="2ff667286217cd73ebcb1c03af993822365000441dfe31a80cb64c5189a9dea8"

# --- LXD ----------------------------------------------------------------------

# Project, managed bridge and storage pool the lab creates, and removes on
# "down". The other labs on this host use 10.250.0.0/24 (openstack-spiffe),
# 10.251.0.0/24 (lxd-spiffe), 10.252.0.0/24 (ligo), 10.77.0.0/24 and
# 10.78.0.0/24 (netcheck).
LAB_PROJECT="veho-lab"
LAB_NETWORK="veho-lab"
LAB_SUBNET="10.254.0.0/24"
LAB_STORAGE_POOL="veho-lab"
# Driver of the pool: dir (needs nothing on the host), zfs or btrfs (instant
# snapshots, in a loop file of LAB_STORAGE_SIZE). Applies when the pool is
# created.
LAB_STORAGE_DRIVER="dir"
LAB_STORAGE_SIZE="60GiB"

# --- Sizes and addresses -----------------------------------------------------

# The lab VM, which runs the inner LXD and the WAN; applied when it is created.
LAB_LXD_CPUS="8"
LAB_LXD_MEMORY="12GiB"
LAB_LXD_DISK="40GiB"
# Host part of its address in LAB_SUBNET; the services are published there.
LAB_LXD_HOST="20"

# The inner LXD: snap channel (refreshes held).
LAB_INNER_LXD_CHANNEL="5.21/stable"
# The regions' subnets are PREFIX.1.0/24 (a), PREFIX.2.0/24 (b) and
# PREFIX.3.0/24 (c), routed only inside the lab VM. In each region: db-X .10,
# s3-X .20, veho-X1 .31, veho-X2 .32.
LAB_REGION_PREFIX="10.60"

# Memory limits of the containers.
LAB_DB_MEMORY="1GiB"
LAB_S3_MEMORY="512MiB"
# The veho nodes of L3 (.specs/veho-lab-l3.md §2).
LAB_VEHO_MEMORY="512MiB"

# Ports on the lab VM's address: BASE plus the region's number (a=1, b=2,
# c=3), so PostgreSQL of region b is published on 5442.
LAB_PG_PORT_BASE="5440"
LAB_PATRONI_PORT_BASE="8000"
LAB_S3_PORT_BASE="9000"
# The fault proxies in front of Garage (.specs/veho-lab-l3.md §2.2).
LAB_FAULT_PORT_BASE="9010"
# The nodes' APIs: BASE + 2 x (region - 1) + index, so veho-a1 is 8441.
LAB_API_PORT_BASE="8440"

# --- The state store (.specs/veho-lab.md §4) ----------------------------------

# etcd timeouts, in milliseconds (veho-architecture.md §3.3).
LAB_ETCD_HEARTBEAT="100"
LAB_ETCD_ELECTION="1000"
# Patroni's DCS timings, in seconds (loop_wait + 2 x retry_timeout <= ttl).
LAB_PATRONI_TTL="30"
LAB_PATRONI_LOOP_WAIT="10"
LAB_PATRONI_RETRY_TIMEOUT="10"

# --- The WAN (.specs/veho-lab.md §3) ------------------------------------------

# Profile applied by "up" and "reset".
LAB_WAN_PROFILE="fiber1"
# Profiles: one-way delays in ms for A-B, A-C and B-C, the same both ways.
LAB_WAN_PROFILE_none="0 0 0"
LAB_WAN_PROFILE_fiber1="9.6 9.6 4.3"
LAB_WAN_PROFILE_fiber2="11.6 12.0 7.4"
LAB_WAN_PROFILE_detour="9.6 13.9 4.3"
LAB_WAN_PROFILE_rtt20="10 10 10"
LAB_WAN_PROFILE_rtt30="15 15 15"
LAB_WAN_PROFILE_rtt40="20 20 20"

# --- Locations ----------------------------------------------------------------

# PKI, passwords, keys, env.json (git-ignored); relative to this directory.
LAB_STATE_DIR=".state"
# Downloads, kept across "down".
LAB_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/veho-lab"

# --- Behaviour ----------------------------------------------------------------

# Answer yes to the confirmation of "down".
LAB_ASSUME_YES="no"
