{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "host": {
      "type": "string",
      "minLength": 1
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "default": 22
    },
    "root": {
      "type": "string",
      "pattern": "^/",
      "description": "the directory holding the objects"
    },
    "host_key": {
      "type": "string",
      "description": "the server's public key, as in known_hosts: ssh-ed25519 AAAA..."
    }
  },
  "required": [
    "host",
    "root",
    "host_key"
  ],
  "additionalProperties": false
}
